<?xml version="1.0" encoding="utf-8"?>
<!--
  Placeholder launcher icon: a solid rounded square. Replace with real
  hotel-branded assets before wider rollout - easiest way is Android
  Studio's Image Asset tool (right-click res/ -> New -> Image Asset).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <corners android:radius="48dp" />
